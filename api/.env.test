# Testumgebung.
#
# Doctrine haengt in der Testumgebung "_test" an den Datenbanknamen an
# (config/packages/doctrine.yaml, dbname_suffix). Steht hier "crm", laufen die
# Tests gegen "crm_test". Der Produktivname ist crm_app — selbst mit Suffix
# kann eine Testsuite ihn also nicht treffen.
#
# Zugangsdaten stehen NICHT hier, sondern in .env.test.local (von Git
# ignoriert). Fuer eine neue Arbeitsumgebung:
#
#   1. mysql -uroot -e "CREATE DATABASE crm_test CHARACTER SET utf8mb4"
#   2. .env.test.local anlegen mit DATABASE_URL (Datenbankname: crm)
#      und JWT_PASSPHRASE — die Schluessel liegen in .env.local, die Symfony
#      in der Testumgebung bewusst nicht laedt.
#   3. APP_ENV=test php bin/console doctrine:schema:create
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
